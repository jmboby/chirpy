# Copy to .env and fill in values. .env is gitignored.
# docker-compose.yml and the app (via godotenv) both read this file.

# Postgres container settings (docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chirpy

# App settings (main.go)
# Must match the POSTGRES_* values above when using the compose db.
DB_URL=postgres://postgres:changeme@localhost:5432/chirpy?sslmode=disable
# "dev" enables the POST /admin/reset endpoint. Anything else disables it.
PLATFORM=dev
